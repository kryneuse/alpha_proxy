# Grafana bind address and port.
# GRAFANA_BIND_ADDRESS=0.0.0.0 makes Grafana reachable from outside the host.
# Use 127.0.0.1 for local-only access.
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000

# Grafana admin credentials. CHANGE_ME must be replaced before deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
