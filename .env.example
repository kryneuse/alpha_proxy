# Docker Compose project name
COMPOSE_PROJECT_NAME=alpha-proxy

# HTTP bind address for the API.
# HTTP_BIND_ADDRESS=0.0.0.0 makes the API reachable from outside the host.
# Use 127.0.0.1 for local-only access.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080

# Directory with ONNX and tokenizer files, mounted read-only into the ML service.
MODELS_DIR=./ml-service/models

# Container image tags
API_IMAGE=alpha-proxy-api:dev
ML_IMAGE=alpha-proxy-ml:dev

# API service tuning
API_PARALLEL_LIMIT=128
API_GLOBAL_RATE_LIMIT_RPS=2000
API_GLOBAL_RATE_LIMIT_BURST=2000

# ML service tuning
ML_GATE_THRESHOLD=0.001
ML_NUM_WORKERS=4
ML_INTRA_OP_THREADS=1
ML_INTER_OP_THREADS=1
ML_MODEL_VERSION=1.0.0